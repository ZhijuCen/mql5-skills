# Copy to `.env` at the project root and adjust.
# Resolution order in skills/mql5/scripts/mql5_helper.py:
#   1. this `.env` (walk-up from the CWD; --env-file PATH, --no-env)
#   2. the real environment variables ($MT5_BASE / $MQL5_DIR / $WINE_DISK_ROOT)
# i.e. values here OVERRIDE exported variables. Both MT5_BASE and MQL5_DIR
# are required — a missing one is an error, never a guessed path.
MT5_BASE="/home/user/.wine/drive_c/Program Files/MetaTrader 5"
MQL5_DIR="/home/user/.wine/drive_c/Program Files/MetaTrader 5/MQL5"
# MT5_PORTABLE_BASE="/home/user/.wine/drive_c/MT5-portable"
# MQL5_PORTABLE_DIR="/home/user/.wine/drive_c/MT5-portable/MQL5"
# Unix only: drive letter that maps to `/` under Wine; ignored on Windows.
WINE_DISK_ROOT="Z"
